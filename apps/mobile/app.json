{
  "expo": {
    "name": "Smart Attendance App",
    "slug": "attendance-pro",
    "scheme": "attendancepro",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Smart Attendance App to use device biometrics for secure quick unlock."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16a34a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#EEFFF4"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://brown-butterfly-424334.hostingersite.com/api/v1",
      "router": {},
      "eas": {
        "projectId": "e29af57b-3aa8-41f9-9183-11b651d8ce9d"
      }
    },
    "android": {
      "package": "com.aruz6.attendancepro",
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "aruz6"
  }
}
