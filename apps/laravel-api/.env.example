APP_NAME="Attendance Pro API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_pro
DB_USERNAME=attendance_user
DB_PASSWORD=change_this_password

JWT_ACCESS_SECRET=change-this-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
ATTENDANCE_EDIT_WINDOW_HOURS=24
LOW_ATTENDANCE_THRESHOLD=75
GEOFENCE_LATITUDE=26.1445
GEOFENCE_LONGITUDE=91.7362
GEOFENCE_RADIUS_METERS=150
