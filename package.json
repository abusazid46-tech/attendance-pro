{
  "name": "attendance-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Attendance Management System for institutions.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm --workspace @attendance/api run db:migrate",
    "db:seed": "npm --workspace @attendance/api run db:seed"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@expo/cli": "^56.1.15"
  }
}
