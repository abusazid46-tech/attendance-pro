# Node/Prisma backend, optional if you choose VPS hosting instead of Hostinger shared hosting.
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance_db?schema=public"
DIRECT_URL="postgresql://attendance:attendance@localhost:5432/attendance_db?schema=public"

# Hostinger Laravel + MySQL backend.
APP_ENV="production"
APP_DEBUG="false"
APP_KEY="base64:generate-this-with-php-artisan-key-generate"
APP_URL="https://api.yourdomain.com"
DB_CONNECTION="mysql"
DB_HOST="your_hostinger_mysql_host"
DB_PORT="3306"
DB_DATABASE="your_hostinger_database"
DB_USERNAME="your_hostinger_database_user"
DB_PASSWORD="your_hostinger_database_password"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="7"
PASSWORD_RESET_TOKEN_TTL_MINUTES="15"
ATTENDANCE_EDIT_WINDOW_HOURS="24"
LOW_ATTENDANCE_THRESHOLD="75"
GEOFENCE_LATITUDE="26.1445"
GEOFENCE_LONGITUDE="91.7362"
GEOFENCE_RADIUS_METERS="150"
API_PORT="4000"
API_BASE_URL="http://localhost:4000"
ADMIN_WEB_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="https://api.yourdomain.com/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="300"
